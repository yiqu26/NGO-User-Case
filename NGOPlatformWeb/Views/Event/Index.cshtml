@model NGOPlatformWeb.Models.Entity.Activity;
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewBag.Title = "活動內容";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userType = ViewBag.UserType as string;
    var registeredIds = ViewBag.RegisteredActivityIds as List<int>;
    var isRegistered = registeredIds != null && registeredIds.Contains(Model.ActivityId);
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>活動介紹頁</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <style>
        .page-title {
            background-color: #fbd0a2;
            padding: 30px;
            text-align: center;
            font-size: 28px;
            color: white;
        }

        .page-wrapper {
            display: flex;
            flex-direction: column;
            padding: 2vw;
            gap: 2vw;
        }

        .main-content {
            display: flex;
            flex-wrap: wrap;
            gap: 2vw;
            width: 100%;
        }

        .image-section {
            flex: 1;
            min-width: 300px;
            display: flex;
            flex-direction: column;
            gap: 1vw;
        }

        .single-image-box {
            height: 20vw;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .single-image-box img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

        .description-section {
            flex: 2;
            min-width: 300px;
            background-color: #fdd;
            padding: 2vw;
            text-align: center;
            border-radius: 12px;
        }

        .text-box {
            background-color: #fee;
            padding: 1vw;
            text-align: center;
            border-radius: 8px;
        }

        .bottom-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2vw;
        }

        .progress {
            flex: 1;
            height: 20px;
            background-color: #eee;
            border-radius: 10px;
            overflow: hidden;
            position: relative;
        }

        .progress-filled {
            height: 100%;
            background-color: pink;
        }

        .signup-btn {
            background-color: #faa;
            padding: 0.8vw 2vw;
            border: none;
            border-radius: 8px;
            font-size: 1.1vw;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="main-content">
        <div class="image-section">
            <div class="single-image-box">
                <img src="@Model.ImageUrl" alt="活動圖片預覽" />
            </div>
            <div class="text-box">(Text)<br />參與條件說明</div>
        </div>
        <div class="description-section">
            <p>@Model.Description</p>
            <p>活動類別：@Model.Category</p>
            <p>活動期間：@Model.StartDate.ToShortDateString() - @Model.EndDate.ToShortDateString()</p>
        </div>
    </div>
    <div class="bottom-bar">
        <div id="signup-count">已報名：@Model.CurrentParticipants 人</div>
        <div class="progress">
            <div class="progress-filled" id="progress-bar" style="width:@((Model.CurrentParticipants * 100 / Model.MaxParticipants))%"></div>
        </div>
        <button type="button" id="actionButton" class="signup-btn"
                onclick="handleClick(@Model.ActivityId, '@Model.ActivityName', @isRegistered.ToString().ToLower())">
            @(isRegistered ? "取消報名" : "立即參與")
        </button>
    </div>

    @Html.Partial("_CaseModals")

    <input type="hidden" id="csrfToken" value="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function handleClick(activityId, activityName, isRegistered) {
            if (isRegistered === "true") {
                // 顯示取消報名確認彈窗
                document.getElementById("cancelActivityName").textContent = activityName;
                document.getElementById("confirmCancelBtn").setAttribute("data-id", activityId);
                var cancelModal = new bootstrap.Modal(document.getElementById("cancelConfirmModal"));
                cancelModal.show();
            } else {
                openCaseRegistrationModal(activityId, activityName);
            }
        }

        function openCaseRegistrationModal(activityId, activityName) {
            fetch(`/Activity/GetActivityInfo?id=${activityId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById("caseActivityName").textContent = activityName;
                        document.getElementById("caseCurrentParticipants").textContent = data.currentParticipants;
                        document.getElementById("caseMaxParticipants").textContent = data.maxParticipants;
                        document.getElementById("caseAvailableSlots").textContent = data.availableSlots;
                        document.getElementById("confirmCaseRegistration").setAttribute("data-id", activityId);
                        var modal = new bootstrap.Modal(document.getElementById("caseRegistrationModal"));
                        modal.show();
                    } else {
                        alert("取得活動資訊失敗：" + data.message);
                    }
                });
        }

        document.getElementById("confirmCaseRegistration").addEventListener("click", function () {
            const activityId = this.getAttribute("data-id");
            fetch("/Activity/RegisterCase", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `activityId=${activityId}`
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById("actionButton").textContent = "取消報名";
                        document.getElementById("actionButton").setAttribute("onclick", `handleClick(${activityId}, '${document.getElementById("caseActivityName").textContent}', true)`);
                        bootstrap.Toast.getOrCreateInstance(document.getElementById("successToast")).show();
                    } else {
                        alert("報名失敗：" + data.message);
                    }
                });
        });

        document.getElementById("confirmCancelBtn").addEventListener("click", function () {
            const activityId = this.getAttribute("data-id");
            fetch("/Activity/CancelRegistrationAjax", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `activityId=${activityId}`
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById("actionButton").textContent = "立即參與";
                        document.getElementById("actionButton").setAttribute("onclick", `handleClick(${activityId}, '${document.getElementById("cancelActivityName").textContent}', false)`);
                        bootstrap.Toast.getOrCreateInstance(document.getElementById("successToast")).show();
                        bootstrap.Modal.getInstance(document.getElementById("cancelConfirmModal")).hide();
                    } else {
                        alert("取消報名失敗：" + data.message);
                    }
                });
        });
    </script>
</body>
</html>
